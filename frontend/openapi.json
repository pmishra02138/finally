{
  "openapi": "3.1.0",
  "info": {
    "title": "FinAlly API",
    "description": "AI Trading Workstation backend API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Health",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/stream/prices": {
      "get": {
        "tags": [
          "streaming"
        ],
        "summary": "Stream Prices",
        "description": "SSE endpoint for live price updates.\n\nStreams all tracked ticker prices every ~500ms. The client connects\nwith EventSource and receives events in the format:\n\n    data: {\"AAPL\": {\"ticker\": \"AAPL\", \"price\": 190.50, ...}, ...}\n\nIncludes a retry directive so the browser auto-reconnects on\ndisconnection (EventSource built-in behavior).",
        "operationId": "stream_prices_api_stream_prices_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/portfolio": {
      "get": {
        "tags": [
          "portfolio"
        ],
        "summary": "Get Portfolio",
        "operationId": "get_portfolio_api_portfolio_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PortfolioResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/portfolio/trade": {
      "post": {
        "tags": [
          "portfolio"
        ],
        "summary": "Execute Trade",
        "operationId": "execute_trade_api_portfolio_trade_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TradeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TradeResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/portfolio/history": {
      "get": {
        "tags": [
          "portfolio"
        ],
        "summary": "Get Portfolio History",
        "operationId": "get_portfolio_history_api_portfolio_history_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/PortfolioSnapshotResponse"
                  },
                  "type": "array",
                  "title": "Response Get Portfolio History Api Portfolio History Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/watchlist": {
      "get": {
        "tags": [
          "watchlist"
        ],
        "summary": "Get Watchlist",
        "operationId": "get_watchlist_api_watchlist_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WatchlistResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "watchlist"
        ],
        "summary": "Add To Watchlist",
        "operationId": "add_to_watchlist_api_watchlist_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WatchlistAddRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WatchlistItemResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/watchlist/{ticker}": {
      "delete": {
        "tags": [
          "watchlist"
        ],
        "summary": "Remove From Watchlist",
        "operationId": "remove_from_watchlist_api_watchlist__ticker__delete",
        "parameters": [
          {
            "name": "ticker",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Ticker"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WatchlistRemoveResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/chat/history": {
      "get": {
        "tags": [
          "chat"
        ],
        "summary": "Get Chat History",
        "operationId": "get_chat_history_api_chat_history_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatHistoryResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "tags": [
          "chat"
        ],
        "summary": "Post Chat",
        "operationId": "post_chat_api_chat_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatMessageResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChatActionResult": {
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "trade",
              "watchlist"
            ],
            "title": "Type"
          },
          "ticker": {
            "type": "string",
            "title": "Ticker"
          },
          "side": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "buy",
                  "sell"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Side"
          },
          "quantity": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Quantity"
          },
          "price": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Price"
          },
          "action": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "add",
                  "remove"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Action"
          },
          "status": {
            "type": "string",
            "enum": [
              "executed",
              "failed"
            ],
            "title": "Status"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "type",
          "ticker",
          "status"
        ],
        "title": "ChatActionResult"
      },
      "ChatHistoryResponse": {
        "properties": {
          "messages": {
            "items": {
              "$ref": "#/components/schemas/ChatMessageResponse"
            },
            "type": "array",
            "title": "Messages"
          }
        },
        "type": "object",
        "required": [
          "messages"
        ],
        "title": "ChatHistoryResponse"
      },
      "ChatMessageResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ],
            "title": "Role"
          },
          "content": {
            "type": "string",
            "title": "Content"
          },
          "actions": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ChatActionResult"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Actions"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "role",
          "content",
          "created_at"
        ],
        "title": "ChatMessageResponse"
      },
      "ChatRequest": {
        "properties": {
          "message": {
            "type": "string",
            "minLength": 1,
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "message"
        ],
        "title": "ChatRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          },
          "market_data_source": {
            "type": "string",
            "title": "Market Data Source"
          },
          "tracked_tickers": {
            "type": "integer",
            "title": "Tracked Tickers"
          }
        },
        "type": "object",
        "required": [
          "status",
          "market_data_source",
          "tracked_tickers"
        ],
        "title": "HealthResponse"
      },
      "PortfolioResponse": {
        "properties": {
          "cash_balance": {
            "type": "number",
            "title": "Cash Balance"
          },
          "total_value": {
            "type": "number",
            "title": "Total Value"
          },
          "total_unrealized_pnl": {
            "type": "number",
            "title": "Total Unrealized Pnl"
          },
          "total_unrealized_pnl_pct": {
            "type": "number",
            "title": "Total Unrealized Pnl Pct"
          },
          "positions": {
            "items": {
              "$ref": "#/components/schemas/PositionResponse"
            },
            "type": "array",
            "title": "Positions"
          }
        },
        "type": "object",
        "required": [
          "cash_balance",
          "total_value",
          "total_unrealized_pnl",
          "total_unrealized_pnl_pct",
          "positions"
        ],
        "title": "PortfolioResponse"
      },
      "PortfolioSnapshotResponse": {
        "properties": {
          "total_value": {
            "type": "number",
            "title": "Total Value"
          },
          "recorded_at": {
            "type": "string",
            "title": "Recorded At"
          }
        },
        "type": "object",
        "required": [
          "total_value",
          "recorded_at"
        ],
        "title": "PortfolioSnapshotResponse"
      },
      "PositionResponse": {
        "properties": {
          "ticker": {
            "type": "string",
            "title": "Ticker"
          },
          "quantity": {
            "type": "number",
            "title": "Quantity"
          },
          "avg_cost": {
            "type": "number",
            "title": "Avg Cost"
          },
          "current_price": {
            "type": "number",
            "title": "Current Price"
          },
          "market_value": {
            "type": "number",
            "title": "Market Value"
          },
          "unrealized_pnl": {
            "type": "number",
            "title": "Unrealized Pnl"
          },
          "unrealized_pnl_pct": {
            "type": "number",
            "title": "Unrealized Pnl Pct"
          },
          "weight_pct": {
            "type": "number",
            "title": "Weight Pct"
          }
        },
        "type": "object",
        "required": [
          "ticker",
          "quantity",
          "avg_cost",
          "current_price",
          "market_value",
          "unrealized_pnl",
          "unrealized_pnl_pct",
          "weight_pct"
        ],
        "title": "PositionResponse"
      },
      "TradeRecord": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "ticker": {
            "type": "string",
            "title": "Ticker"
          },
          "side": {
            "type": "string",
            "enum": [
              "buy",
              "sell"
            ],
            "title": "Side"
          },
          "quantity": {
            "type": "number",
            "title": "Quantity"
          },
          "price": {
            "type": "number",
            "title": "Price"
          },
          "executed_at": {
            "type": "string",
            "title": "Executed At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "ticker",
          "side",
          "quantity",
          "price",
          "executed_at"
        ],
        "title": "TradeRecord"
      },
      "TradeRequest": {
        "properties": {
          "ticker": {
            "type": "string",
            "title": "Ticker"
          },
          "side": {
            "type": "string",
            "enum": [
              "buy",
              "sell"
            ],
            "title": "Side"
          },
          "quantity": {
            "type": "number",
            "title": "Quantity"
          }
        },
        "type": "object",
        "required": [
          "ticker",
          "side",
          "quantity"
        ],
        "title": "TradeRequest"
      },
      "TradeResponse": {
        "properties": {
          "trade": {
            "$ref": "#/components/schemas/TradeRecord"
          },
          "portfolio": {
            "$ref": "#/components/schemas/PortfolioResponse"
          }
        },
        "type": "object",
        "required": [
          "trade",
          "portfolio"
        ],
        "title": "TradeResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "WatchlistAddRequest": {
        "properties": {
          "ticker": {
            "type": "string",
            "title": "Ticker"
          }
        },
        "type": "object",
        "required": [
          "ticker"
        ],
        "title": "WatchlistAddRequest"
      },
      "WatchlistItemResponse": {
        "properties": {
          "ticker": {
            "type": "string",
            "title": "Ticker"
          },
          "price": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Price"
          },
          "previous_price": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Previous Price"
          },
          "change": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Change"
          },
          "change_percent": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Change Percent"
          },
          "direction": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "up",
                  "down",
                  "flat"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Direction"
          },
          "timestamp": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Timestamp"
          },
          "added_at": {
            "type": "string",
            "title": "Added At"
          }
        },
        "type": "object",
        "required": [
          "ticker",
          "added_at"
        ],
        "title": "WatchlistItemResponse"
      },
      "WatchlistRemoveResponse": {
        "properties": {
          "ticker": {
            "type": "string",
            "title": "Ticker"
          },
          "removed": {
            "type": "boolean",
            "title": "Removed"
          }
        },
        "type": "object",
        "required": [
          "ticker",
          "removed"
        ],
        "title": "WatchlistRemoveResponse"
      },
      "WatchlistResponse": {
        "properties": {
          "tickers": {
            "items": {
              "$ref": "#/components/schemas/WatchlistItemResponse"
            },
            "type": "array",
            "title": "Tickers"
          }
        },
        "type": "object",
        "required": [
          "tickers"
        ],
        "title": "WatchlistResponse"
      }
    }
  }
}
